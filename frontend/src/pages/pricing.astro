---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing - Qivio" showFooter={true} showLimitModal={false}>
  <div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Simple, Transparent Pricing</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Start for free, upgrade when you need more. Chat with YouTube videos using AI.
        </p>
      </div>

      <!-- Billing Toggle -->
      <div class="flex justify-center mb-8">
        <div class="bg-white rounded-full p-1 shadow-sm border border-gray-200">
          <button
            id="monthlyBtn"
            class="px-6 py-2 rounded-full text-sm font-medium transition-colors bg-blue-600 text-white"
            data-cycle="monthly"
          >
            Monthly
          </button>
          <button
            id="annualBtn"
            class="px-6 py-2 rounded-full text-sm font-medium transition-colors text-gray-600"
            data-cycle="annual"
          >
            Annual <span class="text-green-600 ml-1">Save 20%</span>
          </button>
        </div>
      </div>

      <!-- Pricing Cards -->
      <div class="grid md:grid-cols-3 gap-8 mb-12">
        <!-- Free Plan -->
        <div class="bg-white rounded-2xl shadow-lg p-8 border border-gray-100">
          <div class="text-center mb-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-2">Free</h2>
            <div class="mb-4">
              <span class="text-4xl font-bold text-gray-900">$0</span>
              <span class="text-gray-500">/month</span>
            </div>
            <p class="text-gray-600 text-sm">Perfect for trying out Qivio</p>
          </div>

          <ul class="space-y-4 mb-8">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700"><strong>3 videos</strong> per month</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700"><strong>50 messages</strong> per month</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700">AI-powered Q&A</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700">Conversation history</span>
            </li>
          </ul>

          <a
            href="/register"
            class="block w-full text-center py-3 px-4 rounded-lg border-2 border-gray-300 text-gray-700 font-semibold hover:bg-gray-50 transition"
          >
            Get Started Free
          </a>
        </div>

        <!-- Pro Plan -->
        <div class="bg-white rounded-2xl shadow-xl p-8 border-2 border-blue-500 relative transform md:scale-105">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2">
            <span class="bg-blue-500 text-white text-sm font-semibold px-4 py-1 rounded-full">
              Most Popular
            </span>
          </div>

          <div class="text-center mb-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-2">Pro</h2>
            <div class="mb-4">
              <span id="proPrice" class="text-4xl font-bold text-gray-900">$12</span>
              <span id="proPeriod" class="text-gray-500">/month</span>
            </div>
            <p class="text-gray-600 text-sm">For power users who need more</p>
          </div>

          <ul class="space-y-4 mb-8">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-blue-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700"><strong>50 videos</strong> per month</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-blue-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700"><strong>1,000 messages</strong> per month</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-blue-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700">Everything in Free</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-blue-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700">Priority support</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-blue-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700">7-day free trial</span>
            </li>
          </ul>

          <button
            id="proCheckoutBtn"
            class="block w-full text-center py-3 px-4 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Start Free Trial
          </button>
        </div>

        <!-- Enterprise Plan -->
        <div class="bg-white rounded-2xl shadow-lg p-8 border border-gray-100">
          <div class="text-center mb-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-2">Enterprise</h2>
            <div class="mb-4">
              <span class="text-4xl font-bold text-gray-900">Custom</span>
            </div>
            <p class="text-gray-600 text-sm">For teams and organizations</p>
          </div>

          <ul class="space-y-4 mb-8">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-purple-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700"><strong>Unlimited</strong> videos</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-purple-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700"><strong>Unlimited</strong> messages</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-purple-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700">Everything in Pro</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-purple-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700">Custom integrations</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-purple-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700">Dedicated support</span>
            </li>
          </ul>

          <a
            href="mailto:contact@qivio.app?subject=Enterprise%20Inquiry"
            class="block w-full text-center py-3 px-4 rounded-lg border-2 border-purple-500 text-purple-600 font-semibold hover:bg-purple-50 transition"
          >
            Contact Sales
          </a>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="bg-white rounded-2xl shadow-lg p-8 max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Frequently Asked Questions</h2>

        <div class="space-y-6">
          <div>
            <h3 class="font-semibold text-gray-900 mb-2">What happens when I exceed my limits?</h3>
            <p class="text-gray-600">You'll be prompted to upgrade to Pro. Your existing videos and conversations remain accessible, but you won't be able to add new videos or send messages until the next billing period.</p>
          </div>

          <div>
            <h3 class="font-semibold text-gray-900 mb-2">Can I cancel anytime?</h3>
            <p class="text-gray-600">Yes! You can cancel your Pro subscription at any time. You'll continue to have access until the end of your current billing period.</p>
          </div>

          <div>
            <h3 class="font-semibold text-gray-900 mb-2">How does the 7-day trial work?</h3>
            <p class="text-gray-600">Start your Pro subscription with a 7-day free trial. You'll only be charged after the trial ends. Cancel anytime during the trial with no charges.</p>
          </div>

          <div>
            <h3 class="font-semibold text-gray-900 mb-2">What payment methods do you accept?</h3>
            <p class="text-gray-600">We accept all major credit cards through Stripe, our secure payment processor.</p>
          </div>
        </div>
      </div>

      <!-- Back to App -->
      <div class="text-center mt-8">
        <a href="/" class="text-blue-600 hover:text-blue-700 font-medium">
          Back to Qivio
        </a>
      </div>
    </div>
  </div>
</Layout>


<script>
  import { getAuth } from '@/lib/auth';
  import { createCheckoutSession, getPlans } from '@/lib/api';

  let currentCycle: 'monthly' | 'annual' = 'monthly';
  let proPlanId: string | null = null;

  // DOM Elements
  const monthlyBtn = document.getElementById('monthlyBtn') as HTMLButtonElement;
  const annualBtn = document.getElementById('annualBtn') as HTMLButtonElement;
  const proPrice = document.getElementById('proPrice') as HTMLSpanElement;
  const proPeriod = document.getElementById('proPeriod') as HTMLSpanElement;
  const proCheckoutBtn = document.getElementById('proCheckoutBtn') as HTMLButtonElement;

  // Toggle billing cycle
  function updatePricing(cycle: 'monthly' | 'annual') {
    currentCycle = cycle;

    if (cycle === 'monthly') {
      monthlyBtn.classList.add('bg-blue-600', 'text-white');
      monthlyBtn.classList.remove('text-gray-600');
      annualBtn.classList.remove('bg-blue-600', 'text-white');
      annualBtn.classList.add('text-gray-600');
      proPrice.textContent = '$12';
      proPeriod.textContent = '/month';
    } else {
      monthlyBtn.classList.remove('bg-blue-600', 'text-white');
      monthlyBtn.classList.add('text-gray-600');
      annualBtn.classList.add('bg-blue-600', 'text-white');
      annualBtn.classList.remove('text-gray-600');
      proPrice.textContent = '$115';
      proPeriod.textContent = '/year';
    }
  }

  monthlyBtn.addEventListener('click', () => updatePricing('monthly'));
  annualBtn.addEventListener('click', () => updatePricing('annual'));

  // Load plans to get Pro plan ID
  async function loadPlans() {
    try {
      const plans = await getPlans();
      const proPlan = plans.find(p => p.name === 'pro');
      if (proPlan) {
        proPlanId = proPlan.id;
      }
    } catch (error) {
      console.error('Failed to load plans:', error);
    }
  }

  loadPlans();

  // Handle checkout
  proCheckoutBtn.addEventListener('click', async () => {
    const auth = getAuth();

    // Redirect to login if not authenticated
    if (!auth.token) {
      window.location.href = '/login?redirect=/pricing';
      return;
    }

    if (!proPlanId) {
      alert('Unable to load pricing. Please try again.');
      return;
    }

    proCheckoutBtn.disabled = true;
    proCheckoutBtn.textContent = 'Redirecting...';

    try {
      const session = await createCheckoutSession(auth.token, proPlanId, currentCycle);
      window.location.href = session.checkout_url;
    } catch (error) {
      console.error('Checkout error:', error);
      alert(error instanceof Error ? error.message : 'Checkout failed');
      proCheckoutBtn.disabled = false;
      proCheckoutBtn.textContent = 'Start Free Trial';
    }
  });
</script>
